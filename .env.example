ENVIRONMENT=development
# Vercel: use a managed Postgres URL, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=sqlite:///./voice_agent.db
PUBLIC_BASE_URL=https://your-public-domain.example
TWILIO_AUTH_TOKEN=replace-me
TWILIO_VALIDATE_SIGNATURES=true
BUSINESS_NAME=Northstar Home Services
BUSINESS_TIMEZONE=Asia/Kolkata
CALENDAR_PROVIDER=memory
# Optional: set CALENDAR_PROVIDER=google and implement a Google Calendar OAuth client.
HUBSPOT_PRIVATE_APP_TOKEN=
ESCALATION_PHONE_NUMBER=
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=~openai/gpt-latest
OPENROUTER_FALLBACK_MODELS=~anthropic/claude-sonnet-latest,openai/gpt-oss-120b
